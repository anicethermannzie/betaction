# ── Server ──────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ── API-Football (direct api-sports.io access) ───────────
# Get your key at: https://dashboard.api-football.com
# (Not the RapidAPI marketplace — this project authenticates with the
# x-apisports-key header, which only direct api-sports.io keys accept.)
RAPID_API_KEY=your_apisports_key_here

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Cron / quota control ──────────────────────────────────
# Both default to true in code when this var is unset entirely — only the
# literal string "false" disables a job. When disabled, that job does not
# register at all on startup (no cron schedule, no immediate warm-up call),
# so it makes zero API-Football requests until you flip it back.
#
# Kept false here on purpose, in every environment, not just local dev:
# neither job is gated by real demand — todayMatchesJob fires every 5 minutes
# regardless of traffic, and liveMatchesJob fires whenever a live match exists
# anywhere, whether or not anyone is actually watching it on this site. Both
# would burn API-Football quota around the clock even with zero users. The
# equivalent on-demand endpoints (served through Redis caching, see
# cacheMiddleware.js) already cover real traffic without an unconditional
# background job; only turn these on if you specifically want a pre-warmed
# cache and have accepted the always-on quota cost that comes with it.
ENABLE_LIVE_POLLING=false
ENABLE_TODAY_MATCHES_CRON=false
