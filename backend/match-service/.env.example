# ── Server ──────────────────────────────────────────────
PORT=3002
NODE_ENV=development

# ── API-Football (direct api-sports.io access) ───────────
# Get your key at: https://dashboard.api-football.com
# (Not the RapidAPI marketplace — this project authenticates with the
# x-apisports-key header, which only direct api-sports.io keys accept.)
RAPID_API_KEY=your_apisports_key_here

# ── Redis ────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000
