# ── Service ──────────────────────────────────────────────
PORT=8000
DEBUG=false
# "production" disables /docs, /redoc and /openapi.json
ENVIRONMENT=development

# ── Match Service ─────────────────────────────────────────
# Use "http://match-service:3002" when running inside Docker Compose
# Use "http://localhost:3002" for local development outside Docker
MATCH_SERVICE_URL=http://localhost:3002
MATCH_SERVICE_TIMEOUT=10.0

# ── Auth ──────────────────────────────────────────────────
# MUST match auth-service's JWT_ACCESS_SECRET. Access tokens are verified here to
# read the plan claim; without it every caller is treated as anonymous/free and
# paying customers silently receive the free response.
JWT_ACCESS_SECRET=your_access_token_secret_here

# ── Redis ─────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Prediction cache ──────────────────────────────────────
PREDICTION_CACHE_TTL=1800   # seconds (30 minutes)

# ── Algorithm tuning ──────────────────────────────────────
LEAGUE_AVG_GOALS=1.5        # baseline average goals per team per match

# ── Concurrency ───────────────────────────────────────────
# Fixtures predicted at once. Each costs ~5 upstream calls to match-service, so
# raising this multiplies load on API-Football.
MAX_CONCURRENT_PREDICTIONS=8

# ── Cache warm-up ─────────────────────────────────────────
# Pre-computes every fixture's prediction once at midnight UTC, win or lose on
# whether anyone asks for it that day — each fixture costs match-service calls
# that can themselves miss cache and spend real API-Football quota. Off by
# default so an idle deployment spends zero quota; opt in only once there is a
# predictable daily user base that actually benefits from a warm cache.
ENABLE_PREDICTION_WARMUP=false
