# ── Server ──────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# ── PostgreSQL ───────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=betaction
DB_USER=postgres
DB_PASSWORD=your_postgres_password

# ── JWT ──────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Required in every environment: at least 32 bytes; placeholders are rejected.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same access secret in auth and notification; Compose reads the root .env.
JWT_ACCESS_SECRET=your_access_token_secret_here
JWT_REFRESH_SECRET=your_refresh_token_secret_here

# ── CORS ─────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ── Stripe billing ───────────────────────────────────────
# Test-mode keys only — see https://dashboard.stripe.com/test/apikeys
# A missing value here does not stop the service from starting; it only makes
# /api/auth/billing/* return 503 (see src/config/stripe.js for why).
#
# STRIPE_SECRET_KEY:    sk_test_... — dashboard > Developers > API keys
# STRIPE_WEBHOOK_SECRET: whsec_... — the signing secret for the specific
#   webhook endpoint you configure in the dashboard (or printed by
#   `stripe listen` when testing locally with the Stripe CLI). Each endpoint
#   URL gets its own secret; do not reuse one across environments.
# STRIPE_PRICE_ID:      price_... — the recurring $9.99/month Price you create
#   under a VIP Product. The server always charges this price; the client
#   never supplies one.
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
STRIPE_PRICE_ID=price_your_recurring_price_id_here

# ── Email (password reset, via AWS SES) ──────────────────
# A missing value here does not stop the service from starting; forgot-password
# always responds 200 regardless (see passwordResetController for why), it just
# silently fails to actually send — see src/config/email.js.
#
# AWS_REGION: the region your SES identity is verified in, e.g. us-east-1.
# EMAIL_FROM: must be a verified identity (email address or domain) in that
#   SES account/region, or SES rejects every send.
# No AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY here on purpose: in production
# this runs under an IAM task role (ECS) with ses:SendEmail permission; the
# AWS SDK's default credential chain picks that up automatically. For local
# development, export those two as real environment variables yourself rather
# than committing them to this file — a leaked SES key can send mail as you.
# SES also starts every account in "sandbox mode", which only delivers to
# verified recipient addresses — move to production access before relying on
# this for real users.
AWS_REGION=us-east-1
EMAIL_FROM=noreply@your-verified-domain.com
