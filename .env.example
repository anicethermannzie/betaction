# =============================================================================
# BetAction — environment variables template
# Copy this file to .env and fill in the values before running docker compose.
# NEVER commit .env to version control.
# =============================================================================

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=betaction
POSTGRES_PASSWORD=betaction_dev_password
POSTGRES_DB=betaction

# ── JWT ───────────────────────────────────────────────────────────────────────
# Required in every environment: at least 32 bytes; placeholders are rejected.
# Generate each secret independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use the same access secret in auth and notification; Compose reads the root .env.
JWT_ACCESS_SECRET=your_jwt_secret_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_change_in_production

# ── Internal service auth ──────────────────────────────────────────────────────
# Shared secret sent as the X-Internal-Api-Key header by any service calling
# notification-service's internal endpoints (POST /notify/match-event, GET /stats).
# Must match INTERNAL_API_KEY in backend/notification-service/.env, plus whichever
# service's .env ends up making that call.
INTERNAL_API_KEY=your_internal_api_key_change_in_production

# ── API Football (RapidAPI) ───────────────────────────────────────────────────
RAPID_API_KEY=your_rapidapi_key_here
RAPID_API_HOST=v3.football.api-sports.io

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
