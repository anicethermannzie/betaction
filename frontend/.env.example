# ── Public (browser) values ───────────────────────────────────────────────────
# NEXT_PUBLIC_* is inlined into the JavaScript bundle at BUILD time, so these
# must be addresses the USER'S BROWSER can reach — never Docker-internal names
# like http://nginx or http://match-service. Setting them at container runtime
# (docker-compose `environment:`) has no effect; change them here and rebuild.

# API gateway, as reachable from the browser.
#   local docker compose → http://localhost/api
#   production           → https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost/api

# Socket.io endpoint. In production this should go through the gateway
# (https://yourdomain.com) rather than hitting the service port directly, so that
# TLS, rate limiting and connection limits apply.
NEXT_PUBLIC_SOCKET_URL=http://localhost:3003

# ── Server-only values ────────────────────────────────────────────────────────
# Used by the /api/auth route handler, which runs on the server. This one MAY be
# a Docker-internal hostname because the browser never sees it.
AUTH_SERVICE_URL=http://localhost:3001
